# Copy this file to ".env" and fill in the values from your Firebase project
# Firebase Console > Project Settings > General > Your apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: base URL for a backend API (e.g. Cloud Functions / Cloud Run)
# that will verify the Firebase ID token on protected endpoints.
VITE_API_BASE_URL=http://localhost:5001/your-project-id/us-central1/api
